<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dashboard_ninja_user" model="res.groups">
        <field name="name">Dashboard Ninja User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_dashboard_ninja_manager" model="res.groups">
        <field name="name">Dashboard Ninja Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_dashboard_ninja_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_dashboard_ninja_board_visibility" model="ir.rule">
        <field name="name">Dashboard Ninja: Public or Personal Boards</field>
        <field name="model_id" ref="model_dashboard_ninja_board"/>
        <field name="domain_force">['|', ('is_public', '=', True), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_ninja_user'))]"/>
    </record>

    <record id="rule_dashboard_ninja_board_manager_all" model="ir.rule">
        <field name="name">Dashboard Ninja Administrator: Full Board Visibility</field>
        <field name="model_id" ref="model_dashboard_ninja_board"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_ninja_manager'))]"/>
    </record>

    <record id="rule_dashboard_ninja_board_multicompany" model="ir.rule">
        <field name="name">Dashboard Ninja Board Multi-Company</field>
        <field name="model_id" ref="model_dashboard_ninja_board"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_dashboard_ninja_item_multicompany" model="ir.rule">
        <field name="name">Dashboard Ninja Item Multi-Company</field>
        <field name="model_id" ref="model_dashboard_ninja_item"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
