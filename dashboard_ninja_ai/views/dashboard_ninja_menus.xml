<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for Interactive OWL Dashboard -->
    <record id="action_dashboard_ninja_client" model="ir.actions.client">
        <field name="name">Ninja AI Dashboard</field>
        <field name="tag">dashboard_ninja_ai.dashboard</field>
    </record>

    <!-- Window Action for Items -->
    <record id="action_dashboard_ninja_items_config" model="ir.actions.act_window">
        <field name="name">Dashboard Items</field>
        <field name="res_model">dashboard.ninja.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Dashboard Card or Chart!
            </p>
        </field>
    </record>

    <!-- Window Action for Boards -->
    <record id="action_dashboard_ninja_boards_config" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">dashboard.ninja.board</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Main Menus -->
    <menuitem id="menu_dashboard_ninja_root"
              name="Ninja Dashboard"
              web_icon="dashboard_ninja_ai,static/description/icon.png"
              sequence="1"/>

    <menuitem id="menu_dashboard_ninja_live"
              name="Analytics &amp; AI Copilot"
              parent="menu_dashboard_ninja_root"
              action="action_dashboard_ninja_client"
              sequence="10"/>

    <menuitem id="menu_dashboard_ninja_config"
              name="Configuration"
              parent="menu_dashboard_ninja_root"
              sequence="50"/>

    <menuitem id="menu_dashboard_ninja_items_sub"
              name="Dashboard Items"
              parent="menu_dashboard_ninja_config"
              action="action_dashboard_ninja_items_config"
              sequence="10"/>

    <menuitem id="menu_dashboard_ninja_boards_sub"
              name="Manage Dashboards"
              parent="menu_dashboard_ninja_config"
              action="action_dashboard_ninja_boards_config"
              sequence="20"/>
</odoo>
