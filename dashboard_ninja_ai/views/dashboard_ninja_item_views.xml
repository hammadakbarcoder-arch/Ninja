<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Item Form View -->
    <record id="view_dashboard_ninja_item_form" model="ir.ui.view">
        <field name="name">dashboard.ninja.item.form</field>
        <field name="model">dashboard.ninja.item</field>
        <field name="arch" type="xml">
            <form string="Dashboard Item Configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Monthly Revenue"/></h1>
                    </div>
                    <group>
                        <group string="Display &amp; Type">
                            <field name="board_id"/>
                            <field name="item_type"/>
                            <field name="theme_color"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Data Source">
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="aggregate_func"/>
                            <field name="field_aggregate" invisible="aggregate_func == 'count'"/>
                            <field name="field_group_by" invisible="item_type == 'kpi'"/>
                        </group>
                    </group>
                    <group string="Target Goals &amp; Growth" invisible="item_type != 'kpi'">
                        <group>
                            <field name="target_value"/>
                            <field name="show_progress"/>
                        </group>
                        <group>
                            <field name="growth_rate"/>
                        </group>
                    </group>
                    <group string="Filter (Domain)">
                        <field name="domain" widget="text" placeholder="[('state', '=', 'sale')]"/>
                    </group>
                    <group string="AI Insights &amp; Briefing" invisible="not ai_insight">
                        <field name="ai_insight" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Item List View -->
    <record id="view_dashboard_ninja_item_list" model="ir.ui.view">
        <field name="name">dashboard.ninja.item.list</field>
        <field name="model">dashboard.ninja.item</field>
        <field name="arch" type="xml">
            <list string="Dashboard Items">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="board_id"/>
                <field name="item_type"/>
                <field name="model_id"/>
                <field name="aggregate_func"/>
                <field name="theme_color"/>
            </list>
        </field>
    </record>

    <!-- Board Form View -->
    <record id="view_dashboard_ninja_board_form" model="ir.ui.view">
        <field name="name">dashboard.ninja.board.form</field>
        <field name="model">dashboard.ninja.board</field>
        <field name="arch" type="xml">
            <form string="Dashboard Board">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="user_id"/>
                        <field name="is_public"/>
                        <field name="sequence"/>
                    </group>
                    <notebook>
                        <page string="Dashboard Items" name="items">
                            <field name="item_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="item_type"/>
                                    <field name="theme_color"/>
                                </list>
                            </field>
                        </page>
                        <page string="AI Executive Briefing" name="ai_summary">
                            <field name="ai_summary" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
